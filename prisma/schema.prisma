generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  LAB
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum DoctorVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum LabVerificationStatus {
  PENDING
  APPROVED
  SUSPENDED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole @default(PATIENT)

  appointments      Appointment[]
  labBookings       LabBooking[]
  caregiverBookings CaregiverBooking[]
  healthRecords     HealthRecord[]
  doctorApplication DoctorApplication?
  labProfile        Lab?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Doctor {
  id             String  @id @default(cuid())
  name           String
  specialization String
  experience     String
  rating         Float   @default(5)
  available      Boolean @default(true)

  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String
  date      String
  time      String
  status    AppointmentStatus @default(PENDING)

  patient User   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor @relation(fields: [doctorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lab {
  id     String @id @default(cuid())
  userId String @unique

  labId     String @unique
  labName   String
  ownerName String
  phone     String

  address String
  area    String
  city    String
  pincode String

  homeCollection Boolean @default(true)

  verificationStatus LabVerificationStatus @default(PENDING)
  active             Boolean               @default(true)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  labBookings LabBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabBooking {
  id        String  @id @default(cuid())
  patientId String
  labId     String?

  patientName String
  mobile      String
  address     String
  testNames   String
  date        String
  time        String

  status BookingStatus @default(PENDING)

  labStage String @default("PENDING")

  orderCreatedAt      DateTime  @default(now())
  labAcceptedAt       DateTime?
  collectorAssignedAt DateTime?
  sampleCollectedAt   DateTime?
  reportUploadedAt    DateTime?
  completedAt         DateTime?

  collectionDeadlineAt DateTime?
  reportDeadlineAt     DateTime?

  reportFileName String?
  reportFileType String?
  reportFileData String?

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lab     Lab? @relation(fields: [labId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CaregiverBooking {
  id          String        @id @default(cuid())
  patientId   String
  patientName String
  phone       String
  address     String
  service     String
  caregiver   String
  date        String
  time        String
  notes       String?
  status      BookingStatus @default(PENDING)

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HealthRecord {
  id         String @id @default(cuid())
  patientId  String
  reportName String
  recordType String
  reportDate String
  fileName   String
  fileType   String
  fileData   String

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model DoctorApplication {
  id     String @id @default(cuid())
  userId String @unique

  fullName String
  email    String
  mobile   String

  medicalRegistrationNumber String

  specialization String
  qualification  String
  experience     String
  dob            String

  clinicHospital String
  clinicAddress  String?

  identityDocumentName String
  identityDocumentType String
  identityDocumentData String

  medicalCertificateName String
  medicalCertificateType String
  medicalCertificateData String

  otherDocuments String?

  status DoctorVerificationStatus @default(PENDING)

  adminNotes String?
  reviewedBy String?
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
